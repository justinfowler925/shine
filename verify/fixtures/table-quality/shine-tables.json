{
  "version": 1,
  "project": ".",
  "grids": [
    {
      "selector": "#queue",
      "title": "h1",
      "toolbar": "#toolbar",
      "kind": "records",
      "source": {
        "entry": "candidate.html",
        "shared": "shared.js",
        "referenceEntry": "reference.html"
      },
      "reference": {
        "target": "reference.html",
        "selector": "#queue",
        "title": "h1",
        "toolbar": "#toolbar"
      },
      "cases": {
        "sort": {
          "steps": [
            {
              "op": "rows",
              "selector": "tbody .account",
              "equals": [
                "Bravo",
                "Acme"
              ]
            },
            {
              "op": "click",
              "selector": "#sort"
            },
            {
              "op": "rows",
              "selector": "tbody .account",
              "equals": [
                "Acme",
                "Bravo"
              ]
            },
            {
              "op": "click",
              "selector": "#sort"
            },
            {
              "op": "rows",
              "selector": "tbody .account",
              "equals": [
                "Delta",
                "Cedar"
              ]
            }
          ]
        },
        "search": {
          "steps": [
            {
              "op": "rows",
              "selector": "tbody .account",
              "equals": [
                "Bravo",
                "Acme"
              ]
            },
            {
              "op": "fill",
