                "Acme"
              ]
            },
            {
              "op": "fill",
              "selector": "input",
              "value": ""
            },
            {
              "op": "rows",
              "selector": "tbody .account",
              "equals": [
                "Bravo",
                "Acme"
              ]
            }
          ]
        },
        "filter": {
          "steps": [
            {
              "op": "rows",
              "selector": "tbody .account",
