  "flows": [
    {
      "id": "projects",
      "path": "/library?view=projects",
      "userJob": "Move a project through the board",
      "steps": [
        {
          "action": "select",
          "selector": "select[aria-label=\"Move Evergreen launch\"]",
          "value": "active"
        },
        {
          "action": "text",
          "selector": "section[aria-label=\"In motion\"]",
          "value": "Evergreen launch"
        },
        {
          "action": "text",
          "selector": ".workspace-metrics>div:nth-child(2)",
          "value": "3"
        }
      ]
    },
    {
      "id": "activity",
      "path": "/library?view=activity",
      "userJob": "Read all notifications and see the unread count clear",
      "steps": [
        {
          "action": "click",
          "selector": "button:has-text(\"Notifications (3)\")"
        },
        {
          "action": "click",
          "selector": "button:has-text(\"Mark all read\")"
        },
        {
          "action": "text",
          "selector": "[role=dialog]",
          "value": "0 unread"
        }
      ]
    },
    {
      "id": "team",
      "path": "/library?view=team",
      "userJob": "Find and inspect a teammate",
      "steps": [
        {
          "action": "fill",
          "selector": "input[type=search]",
          "value": "Riley"
        },
        {
          "action": "count",
          "selector": ".teammate",
          "value": 1
        },
        {
          "action": "click",
          "selector": "button[aria-label=\"View Riley Chen profile\"]"
        },
        {
          "action": "text",
          "selector": "[role=dialog]",
          "value": "Portland"
        }
      ]
    },
    {
      "id": "billing",
      "path": "/library?view=billing",
      "userJob": "Choose a plan using the installed form",
      "steps": [
        {
          "action": "click",
          "selector": "button:has-text(\"Change plan\")"
        },
        {
          "action": "select",
          "selector": "select[name=plan]",
          "value": "solo"
        },
        {
          "action": "click",
          "selector": "button:has-text(\"Save changes\")"
        },
        {
          "action": "text",
          "selector": ".billing-feature h2",
          "value": "Solo"
        }
      ]
    },
    {
      "id": "help",
      "path": "/library?view=help",
      "userJob": "Find the right guide and ask for more help",
      "steps": [
        {
          "action": "fill",
          "selector": "input[type=search]",
          "value": "plan"
        },
        {
          "action": "click",
          "selector": ".help-article"
        },
        {
          "action": "click",
          "selector": "button:has-text(\"I need more help\")"
        },
        {
          "action": "visible",
          "selector": ".guide-article footer a"
        }
      ]
    },
    {
      "id": "editor",
      "path": "/library?view=editor",
      "userJob": "Save a document with correctly associated fields",
      "steps": [
        {
          "action": "fill",
          "selector": "input[name=title]",
          "value": "A finished system"
        },
        {
          "action": "fill",
          "selector": "textarea[name=body]",
          "value": "A useful source for every next page."
        },
        {
          "action": "click",
          "selector": "button:has-text(\"Save changes\")"
        },
        {
          "action": "text",
          "selector": ".document-preview h2",
          "value": "A finished system"
        }
      ]
    },
    {
      "id": "account",
      "path": "/library?view=signup",
      "userJob": "Create the clearly labeled sample profile",
      "steps": [
        {
          "action": "fill",
          "selector": "input[name=name]",
          "value": "Jordan"
        },
        {
          "action": "click",
          "selector": "button:has-text(\"Create demo profile\")"
        },
        {
          "action": "text",
          "selector": ".completion-panel",
          "value": "You\u2019re ready to explore."
        }
      ]
    },
    {
      "id": "recovery",
      "path": "/library?view=status",
      "userJob": "Recover from a failed connection",
      "steps": [
        {
          "action": "click",
          "selector": "button[role=tab]:has-text(\"Connection error\")"
        },
        {
          "action": "click",
          "selector": "button:has-text(\"Retry\")"
        },
        {
          "action": "text",
          "selector": ".completion-panel",
          "value": "Connection restored."
        }
      ]
    },
    {
      "id": "commerce",
      "path": "/library?view=product",
      "userJob": "Choose a cover, add to bag and inspect the actual total",
      "steps": [
        {
          "action": "click",
          "selector": "button[aria-label=\"Lilac cover\"]"
        },
        {
          "action": "select",
          "selector": "select[aria-label=\"Product quantity\"]",
          "value": "2"
        },
        {
          "action": "click",
          "selector": "button:has-text(\"Add to bag\")"
        },
        {
          "action": "click",
          "selector": "a:has-text(\"View your bag\")"
        },
        {
          "action": "text",
          "selector": ".order-summary",
          "value": "64"
        }
      ]
    },
    {
      "id": "reuse",
      "path": "/library?view=landing",
      "userJob": "Find the whole example source and installed components",
      "steps": [
        {
          "action": "click",
          "selector": "button:has-text(\"Use this pattern\")"
        },
        {
          "action": "visible",
          "selector": ".source-panel a:has-text(\"View complete example source\")"
        },
        {
          "action": "click",
          "selector": ".source-panel a:has-text(\"Browse installable components\")"
        },
        {
          "action": "visible",
          "selector": ".pattern-grid"
        },
        {
          "action": "count",
          "selector": ".pattern-card",
          "value": 32
        }
      ]
    }
  ]
}
