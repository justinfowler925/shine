{
  "name": "@shine/root",
  "version": "4.0.2",
  "private": "true",
  "type": "module",
  "description": "shine \u2014 design authority. Root deps are the ones the verification loop needs; the token pipeline has its own package.json under tokens/.",
  "scripts": {
    "build": "npm run build --prefix tokens",
    "verify": "npm run verify --prefix tokens",
    "gen": "npm run gen --prefix tokens",
    "doctor": "node verify/doctor.mjs",
    "doctor:full": "node verify/doctor.mjs --full",
    "measure": "node verify/measure.mjs",
    "cite": "node corpus/cite.mjs",
    "packet": "node core/design-packet.mjs",
    "render": "node core/render-spec.mjs",
    "materialize": "node corpus/materialize-packs.mjs",
    "sync-consumers": "bash scripts/sync-consumers.sh",
    "skill-listing": "node site/scripts/skill-listing.mjs",
    "measure-consumers": "node verify/measure-consumers.mjs",
    "compare": "node verify/compare.mjs",
    "compare:product": "node verify/compare-product.mjs",
    "compare:product:test": "node verify/product-consistency.test.mjs",
    "usability": "node verify/usability.mjs",
    "usability:test": "node verify/usability.test.mjs",
    "sweep:test": "node verify/stop-sweep-proof.test.mjs",
    "census:test": "node verify/region-census.test.mjs",
    "benchmark:smoke": "node benchmark/run.mjs",
    "benchmark:full": "node benchmark/run.mjs --full",
    "benchmark:test": "node benchmark/benchmark.test.mjs",
    "benchmark:quality": "node benchmark/quality.test.mjs",
    "benchmark:agent:test": "node benchmark/agent-production.test.mjs",
    "benchmark:agent:score:test": "node benchmark/agent-score.test.mjs",
    "benchmark:agent:representative": "node benchmark/agent-corpus.mjs --set representative",
    "benchmark:agent:full": "node benchmark/agent-corpus.mjs",
    "layers:test": "node verify/component-layers.test.mjs",
    "packet:test": "node verify/design-packet.test.mjs",
    "render:test": "node verify/design-spec.test.mjs",
    "diagnosis:test": "node verify/diagnosis.test.mjs",
    "reference:test": "node verify/reference-contract.test.mjs",
    "voice:test": "node verify/voice-contrast.test.mjs",
    "slds:test": "node verify/slds-tokens.test.mjs",
    "release:test": "node verify/release.test.mjs",
    "site:test": "node --test verify/site-proof.test.mjs",
    "site:live": "node verify/live-site.mjs",
    "untitled": "untitledui",
    "untitled:index": "node corpus/untitledui.mjs --index",
    "untitled:search": "node corpus/untitledui.mjs",
    "table:test": "node verify/table-quality.test.mjs",
    "table:verify": "node verify/table-quality.mjs",
    "layout:test": "node verify/media-layout.test.mjs",
    "layout:verify": "node verify/layout.mjs",
    "prove": "node verify/prove.mjs",
    "blocks:test": "node verify/blocks.test.mjs && node verify/blocks-browser.mjs && tsc -p verify/fixtures/blocks/tsconfig.json",
    "library:build": "node site/scripts/build-library.mjs",
    "library:test": "node verify/coverage.test.mjs && node verify/library-browser.mjs",
    "system:test": "node verify/system-tools.test.mjs && node verify/system-browser.mjs"
  },
  "devDependencies": {
    "@cursor/sdk": "^1.0.30",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.45.0",
    "papaparse": "^5.5.3",
    "playwright": "^1.62.1",
    "postcss": "^8.5.28",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "untitledui": "0.1.64"
  },
  "overrides": {
    "undici": "6.28.0"
  },
  "license": "ISC"
}
